---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Sidebar from '../components/Sidebar.astro';

const { title, activeSlug } = Astro.props as { title?: string; activeSlug?: string };
const pageTitle = title ? `${title} — Shabtai's Teaching Tools` : "Shabtai's Teaching Tools";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-open-sans" preload />
    <title>{pageTitle}</title>
    <script is:inline>
      // Resolve the sidebar state before first paint so an embed never
      // flashes the full menu. Precedence: URL param > this tab's choice
      // > the saved preference. URL: ?menu=collapsed|expanded, ?embed=1
      (function () {
        var KEY = "shabtai-tools:menu-collapsed";
        var collapsed = null;

        function read(store) {
          try {
            return window[store].getItem(KEY);
          } catch (e) {
            return null;
          }
        }

        try {
          var params = new URLSearchParams(window.location.search);
          var menu = params.get("menu");
          var embed = params.get("embed");
          if (menu !== null) {
            if (/^(collapsed|collapse|closed|hidden|ribbon|0|false)$/i.test(menu))
              collapsed = true;
            else if (/^(expanded|expand|open|full|1|true)$/i.test(menu))
              collapsed = false;
          }
          if (collapsed === null && embed !== null && /^(1|true|yes)$/i.test(embed))
            collapsed = true;
          if (collapsed !== null) {
            // Remember for this tab so the state survives clicking through
            // the site from an embed link, without overwriting the
            // long-lived preference set via the toggle button.
            try {
              window.sessionStorage.setItem(KEY, collapsed ? "1" : "0");
            } catch (e) {}
          }
        } catch (e) {}

        if (collapsed === null) {
          var tab = read("sessionStorage");
          if (tab !== null) collapsed = tab === "1";
        }
        if (collapsed === null) {
          var saved = read("localStorage");
          if (saved !== null) collapsed = saved === "1";
        }
        if (collapsed) document.documentElement.classList.add("menu-collapsed");
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div class="flex">
      <Sidebar activeSlug={activeSlug} />
      <main class="flex-1 min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
