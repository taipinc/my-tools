---
import { categories } from "../data/tools";

const { activeSlug } = Astro.props as { activeSlug?: string };
const base = import.meta.env.BASE_URL;
---

<aside
    id="site-sidebar"
    class="sticky top-0 h-screen shrink-0 border-r border-[var(--color-rule)] bg-[var(--color-paper-2)]/40 overflow-y-auto overflow-x-hidden"
>
    <div
        class="sidebar-head flex items-start gap-2 px-5 pt-6 pb-4 border-b border-[var(--color-rule)]"
    >
        <a href={base} class="sidebar-full group min-w-0 flex-1">
            <div
                class="text-xl font-semibold tracking-tight text-[var(--color-ink)]"
            >
                Shabtai's Teaching Tools
            </div>
        </a>
        <button
            type="button"
            id="menu-toggle"
            class="shrink-0 rounded p-1.5 text-[var(--color-ink-soft)] hover:bg-[var(--color-paper-2)] hover:text-[var(--color-ink)] cursor-pointer"
            aria-controls="site-sidebar"
            aria-expanded="true"
            aria-label="Collapse menu"
            title="Collapse menu"
        >
            <svg
                class="menu-toggle-close"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M15 6l-6 6 6 6" />
                <path d="M4 4v16" />
            </svg>
            <svg
                class="menu-toggle-open"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M9 6l6 6-6 6" />
                <path d="M20 4v16" />
            </svg>
        </button>
    </div>

    <nav class="sidebar-full px-3 py-4 space-y-6 text-[15px]">
        <a
            href={base}
            class={`block px-2 py-1.5 rounded ${!activeSlug ? "bg-[var(--color-accent-soft)] text-[var(--color-ink)]" : "hover:bg-[var(--color-paper-2)] text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]"}`}
        >
            Home
        </a>

        {
            categories.map((category) => (
                <div>
                    <div class="px-2 mb-2 text-[12px] font-extrabold text-[var(--color-ink)]">
                        {category.name}
                    </div>
                    {category.tools.length === 0 ? (
                        <div class="px-2 py-1 text-[13px] italic text-[var(--color-ink-soft)] opacity-70">
                            — nothing here yet —
                        </div>
                    ) : (
                        <ul class="space-y-0.5">
                            {category.tools.map((tool) => {
                                const active = tool.slug === activeSlug;
                                return (
                                    <li>
                                        <a
                                            href={`${base}tools/${tool.slug}`}
                                            class={`flex items-center justify-between px-2 py-1.5 rounded ${active ? "bg-[var(--color-accent-soft)] text-[var(--color-ink)]" : "hover:bg-[var(--color-paper-2)] text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]"}`}
                                        >
                                            <span>{tool.name}</span>
                                            {tool.status === "coming-soon" && (
                                                <span class="text-[10px] uppercase tracking-wider text-[var(--color-mark)] opacity-80">
                                                    soon
                                                </span>
                                            )}
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    )}
                </div>
            ))
        }
    </nav>
</aside>

<script is:inline>
    (function () {
        var KEY = "shabtai-tools:menu-collapsed";
        var btn = document.getElementById("menu-toggle");
        if (!btn) return;

        function save(store, value) {
            try {
                window[store].setItem(KEY, value);
            } catch (e) {
                /* storage blocked (private mode, third-party iframe) */
            }
        }

        function sync() {
            var collapsed =
                document.documentElement.classList.contains("menu-collapsed");
            var label = collapsed ? "Expand menu" : "Collapse menu";
            btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
            btn.setAttribute("aria-label", label);
            btn.setAttribute("title", label);
        }

        btn.addEventListener("click", function () {
            var collapsed =
                document.documentElement.classList.toggle("menu-collapsed");
            var value = collapsed ? "1" : "0";
            // localStorage = the durable preference; sessionStorage keeps the
            // choice for this tab so it survives navigation inside an embed.
            save("localStorage", value);
            save("sessionStorage", value);
            sync();
        });

        sync();
    })();
</script>
